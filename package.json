{
  "name": "solverino",
  "displayName": "Solverino \u2014 Issue & PR Worktrees",
  "description": "One-click git worktrees for your GitHub Issues & Pull Requests \u2014 see which ones already have a worktree and clean them up when done.",
  "version": "0.2.1",
  "publisher": "emanuel-wyss",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=18"
  },
  "categories": [
    "Other",
    "SCM Providers"
  ],
  "keywords": [
    "worktree",
    "github",
    "pull request",
    "issues"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Solverino",
      "properties": {
        "solverino.worktreeParentFolder": {
          "type": "string",
          "default": "",
          "markdownDescription": "Parent folder for worktrees. Empty = sibling of the repository folder (e.g. `../solverino-<repo>-issue-42`)."
        },
        "solverino.pollIntervalSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 0,
          "markdownDescription": "How often to refresh Issues/PRs from GitHub. 0 disables polling."
        },
        "solverino.showAllOpenIssues": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Show all open issues in the overview, not only the ones assigned to you."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "solverino",
          "title": "Solverino",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "solverino": [
        {
          "id": "solverino.overview",
          "name": "Issues & PRs"
        }
      ]
    },
    "commands": [
      {
        "command": "solverino.refresh",
        "title": "Refresh Issues & PRs",
        "icon": "$(refresh)",
        "category": "Solverino"
      },
      {
        "command": "solverino.openWorktree",
        "title": "Open Worktree",
        "icon": "$(folder-opened)",
        "category": "Solverino"
      },
      {
        "command": "solverino.cleanupWorktree",
        "title": "Cleanup Worktree",
        "icon": "$(trash)",
        "category": "Solverino"
      },
      {
        "command": "solverino.openOnGitHub",
        "title": "Open on GitHub",
        "icon": "$(globe)",
        "category": "Solverino"
      },
      {
        "command": "solverino.openInCodespace",
        "title": "Open in Codespace",
        "icon": "$(cloud)",
        "category": "Solverino"
      },
      {
        "command": "solverino.openCopilotAgent",
        "title": "Open Copilot Agent",
        "icon": "$(sparkle)",
        "category": "Solverino"
      },
      {
        "command": "solverino.createDraftPR",
        "title": "Create Draft PR",
        "icon": "$(git-pull-request-draft)",
        "category": "Solverino"
      },
      {
        "command": "solverino.cleanupOrphan",
        "title": "Cleanup Orphaned Worktree",
        "icon": "$(trash)",
        "category": "Solverino"
      },
      {
        "command": "solverino.myWeek",
        "title": "My Week (Merged & Closed)",
        "icon": "$(graph)",
        "category": "Solverino"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "solverino.myWeek",
          "when": "view == solverino.overview",
          "group": "navigation"
        },
        {
          "command": "solverino.refresh",
          "when": "view == solverino.overview",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "solverino.openWorktree",
          "when": "view == solverino.overview && viewItem =~ /^(issue|pr)/",
          "group": "worktree"
        },
        {
          "command": "solverino.cleanupWorktree",
          "when": "view == solverino.overview && viewItem =~ /^(issue|pr):worktree$/",
          "group": "worktree"
        },
        {
          "command": "solverino.openOnGitHub",
          "when": "view == solverino.overview && viewItem =~ /^(issue|pr)/",
          "group": "github"
        },
        {
          "command": "solverino.openInCodespace",
          "when": "view == solverino.overview && viewItem =~ /^(issue|pr)/",
          "group": "github"
        },
        {
          "command": "solverino.openCopilotAgent",
          "when": "view == solverino.overview && viewItem =~ /^(issue|pr)/",
          "group": "worktree"
        },
        {
          "command": "solverino.createDraftPR",
          "when": "view == solverino.overview && viewItem =~ /^issue/",
          "group": "flows"
        },
        {
          "command": "solverino.cleanupOrphan",
          "when": "view == solverino.overview && viewItem =~ /^orphan/",
          "group": "worktree"
        }
      ],
      "view/item/inline": [
        {
          "command": "solverino.openWorktree",
          "when": "view == solverino.overview && viewItem =~ /^(issue|pr)/",
          "group": "inline@1"
        },
        {
          "command": "solverino.cleanupWorktree",
          "when": "view == solverino.overview && viewItem =~ /^(issue|pr):worktree$/",
          "group": "inline@2"
        },
        {
          "command": "solverino.cleanupOrphan",
          "when": "view == solverino.overview && viewItem =~ /^orphan/",
          "group": "inline@1"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.json --outDir out && mocha 'out/test/**/*.test.js'",
    "package": "vsce package",
    "vsix": "vsce package --allow-missing-repository"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.20.1",
    "mocha": "^10.3.0",
    "typescript": "^5.4.2",
    "@vscode/vsce": "^3.6.0"
  }
}
