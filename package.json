{
  "name": "swarmforge",
  "displayName": "Swarmforge — Parallel PR Agents",
  "description": "Parallel AI coding agents for your Issues & PRs — one chat and one git worktree each, with live progress and one-click PR actions.",
  "version": "0.1.0",
  "publisher": "emanuel-wyss",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=18"
  },
  "categories": [
    "Other",
    "Chat",
    "SCM Providers"
  ],
  "keywords": [
    "ai",
    "agents",
    "worktree",
    "github",
    "pull request",
    "copilot"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Swarmforge",
      "properties": {
        "swarmforge.maxConcurrentAgents": {
          "type": "number",
          "default": 4,
          "minimum": 1,
          "description": "Maximum number of agent processes running in parallel. Additional chats are queued."
        },
        "swarmforge.worktreeParentFolder": {
          "type": "string",
          "default": "",
          "markdownDescription": "Parent folder for worktrees. Empty = sibling of the repository folder (e.g. `../swarmforge-<repo>-issue-42`)."
        },
        "swarmforge.agentCommand": {
          "type": "string",
          "default": "copilot",
          "markdownDescription": "Agent executable to run per chat (e.g. `copilot`). It is invoked as `<command> -p <prompt>` with `cwd` set to the chat's worktree."
        },
        "swarmforge.agentResumeArgs": {
          "type": "string",
          "default": "--continue",
          "markdownDescription": "Arguments appended to continue a previous agent session on follow-up messages (e.g. `--continue` for Copilot CLI)."
        },
        "swarmforge.envSetupCommand": {
          "type": "string",
          "default": "",
          "markdownDescription": "Optional shell command run once in a freshly created worktree (e.g. `npm install`). Empty = skipped."
        },
        "swarmforge.pollIntervalSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 0,
          "markdownDescription": "How often to refresh Issues/PRs from GitHub. 0 disables polling."
        },
        "swarmforge.showAllOpenIssues": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Show all open issues in the overview, not only the ones assigned to you."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "swarmforge",
          "title": "Swarmforge",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "swarmforge": [
        {
          "id": "swarmforge.overview",
          "name": "Issues & PRs"
        }
      ]
    },
    "commands": [
      {
        "command": "swarmforge.refresh",
        "title": "Refresh Issues & PRs",
        "icon": "$(refresh)",
        "category": "Swarmforge"
      },
      {
        "command": "swarmforge.openChat",
        "title": "Start Chat",
        "icon": "$(comment-discussion)",
        "category": "Swarmforge"
      },
      {
        "command": "swarmforge.createWorktree",
        "title": "Create Worktree",
        "icon": "$(git-branch)",
        "category": "Swarmforge"
      },
      {
        "command": "swarmforge.cleanupWorktree",
        "title": "Cleanup Worktree",
        "icon": "$(trash)",
        "category": "Swarmforge"
      },
      {
        "command": "swarmforge.startAgent",
        "title": "Start Agent",
        "icon": "$(play)",
        "category": "Swarmforge"
      },
      {
        "command": "swarmforge.stopAgent",
        "title": "Stop Agent",
        "icon": "$(debug-stop)",
        "category": "Swarmforge"
      },
      {
        "command": "swarmforge.commit",
        "title": "Commit Changes in Worktree",
        "icon": "$(check)",
        "category": "Swarmforge"
      },
      {
        "command": "swarmforge.pushAndCreatePR",
        "title": "Push & Create Pull Request",
        "icon": "$(git-pull-request)",
        "category": "Swarmforge"
      },
      {
        "command": "swarmforge.openWorktreeInNewWindow",
        "title": "Open Worktree in New Window",
        "icon": "$(folder-opened)",
        "category": "Swarmforge"
      },
      {
        "command": "swarmforge.openOnGitHub",
        "title": "Open on GitHub",
        "icon": "$(globe)",
        "category": "Swarmforge"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "swarmforge.refresh",
          "when": "view == swarmforge.overview",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "swarmforge.openChat",
          "when": "view == swarmforge.overview && viewItem =~ /^(issue|pr)/",
          "group": "inline@1"
        },
        {
          "command": "swarmforge.startAgent",
          "when": "view == swarmforge.overview && viewItem =~ /^(issue|pr)/",
          "group": "inline@2"
        },
        {
          "command": "swarmforge.createWorktree",
          "when": "view == swarmforge.overview && viewItem =~ /^(issue|pr)/",
          "group": "worktree"
        },
        {
          "command": "swarmforge.cleanupWorktree",
          "when": "view == swarmforge.overview && viewItem =~ /^(issue|pr)/",
          "group": "worktree"
        },
        {
          "command": "swarmforge.openWorktreeInNewWindow",
          "when": "view == swarmforge.overview && viewItem =~ /^(issue|pr)/",
          "group": "worktree"
        },
        {
          "command": "swarmforge.openOnGitHub",
          "when": "view == swarmforge.overview && viewItem =~ /^(issue|pr)/",
          "group": "github"
        }
      ],
      "view/item/inline": [
        {
          "command": "swarmforge.openChat",
          "when": "view == swarmforge.overview && viewItem =~ /^(issue|pr)/",
          "group": "inline@1"
        },
        {
          "command": "swarmforge.startAgent",
          "when": "view == swarmforge.overview && viewItem =~ /^(issue|pr)/",
          "group": "inline@2"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc --noEmit",
    "test": "mocha out/test/**/*.test.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.20.1",
    "mocha": "^10.3.0",
    "typescript": "^5.4.2"
  }
}
